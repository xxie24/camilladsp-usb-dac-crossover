#!/usr/bin/env python3
"""Quickly switch the live CamillaDSP config on this Raspberry Pi.

Uses the CamillaDSP websocket API (SetConfigFilePath + Reload), so switching
is instant with no service restart. The statefile is also updated so the
choice survives reboots. Falls back to `systemctl restart camilladsp` if the
websocket is unreachable. Stdlib only, no pip packages needed.

Usage:
  dsp-switch status              show active config + processing state
  dsp-switch with-sub            2.1: mains + subwoofer (active_config.yml)
  dsp-switch mains-only|no-sub   stereo mains only (mains_only.yml)
  dsp-switch <name>              any other file in ~/camilladsp/configs/
"""

import base64
import json
import os
import socket
import ssl
import subprocess
import sys
import time
import urllib.parse

CONFIG_DIR = "/home/xxie/camilladsp/configs"
STATEFILE = "/home/xxie/camilladsp/statefile.yml"
WS_URL = "ws://localhost:1234"

PROFILES = {
    "with-sub": "active_config.yml",
    "mains-only": "mains_only.yml",
    "no-sub": "mains_only.yml",
}


class WsError(Exception):
    pass


class MiniWs:
    """Minimal RFC 6455 client: handshake, masked text frames, ping/pong."""

    def __init__(self, url, timeout=5):
        u = urllib.parse.urlparse(url)
        host = u.hostname or "localhost"
        port = u.port or (443 if u.scheme == "wss" else 80)
        path = u.path or "/"
        self._sock = socket.create_connection((host, port), timeout=timeout)
        if u.scheme == "wss":
            ctx = ssl.create_default_context()
            self._sock = ctx.wrap_socket(self._sock, server_hostname=host)
        self._sock.settimeout(timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\n"
            "Upgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
        )
        self._sock.sendall(req.encode())
        resp = b""
        while b"\r\n\r\n" not in resp:
            chunk = self._sock.recv(4096)
            if not chunk:
                raise WsError("handshake failed: connection closed")
            resp += chunk
        if b"101" not in resp.split(b"\r\n", 1)[0]:
            raise WsError(f"handshake rejected: {resp[:120]!r}")

    def _read_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self._sock.recv(n - len(buf))
            if not chunk:
                raise WsError("connection closed mid-frame")
            buf += chunk
        return buf

    def _send_frame(self, opcode, payload):
        mask = os.urandom(4)
        n = len(payload)
        if n < 126:
            hdr = bytes([0x80 | opcode, 0x80 | n])
        elif n < 65536:
            hdr = bytes([0x80 | opcode, 0x80 | 126]) + n.to_bytes(2, "big")
        else:
            hdr = bytes([0x80 | opcode, 0x80 | 127]) + n.to_bytes(8, "big")
        self._sock.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def send_text(self, text):
        self._send_frame(0x1, text.encode())

    def recv_text(self):
        parts = []
        while True:
            b1, b2 = self._read_exact(2)
            fin, opcode = b1 & 0x80, b1 & 0x0F
            ln = b2 & 0x7F
            if ln == 126:
                ln = int.from_bytes(self._read_exact(2), "big")
            elif ln == 127:
                ln = int.from_bytes(self._read_exact(8), "big")
            if b2 & 0x80:  # server must not mask; skip mask if present anyway
                self._read_exact(4)
            payload = self._read_exact(ln) if ln else b""
            if opcode == 0x9:  # ping -> pong
                self._send_frame(0xA, payload)
            elif opcode == 0xA:  # pong
                continue
            elif opcode == 0x8:  # close
                raise WsError("server closed connection")
            elif opcode in (0x1, 0x0):  # text / continuation
                parts.append(payload)
                if fin:
                    return b"".join(parts).decode()
            else:
                raise WsError(f"unexpected opcode {opcode:#x}")

    def query(self, cmd):
        self.send_text(json.dumps(cmd))
        return json.loads(self.recv_text())

    def close(self):
        try:
            self._send_frame(0x8, b"")
        except OSError:
            pass
        try:
            self._sock.close()
        except OSError:
            pass


def ws_query(cmd, timeout=5):
    ws = MiniWs(WS_URL, timeout=timeout)
    try:
        return ws.query(cmd)
    finally:
        ws.close()


def check_result(cmd_name, resp):
    """Return (ok, value_or_error_string) for a websocket response."""
    try:
        inner = resp[cmd_name]
    except (KeyError, TypeError):
        return False, f"unexpected reply: {resp!r}"
    if inner.get("result") != "Ok":
        return False, inner.get("result", "Error")
    return True, inner.get("value")


def resolve_target(arg):
    if arg in PROFILES:
        return os.path.join(CONFIG_DIR, PROFILES[arg])
    for cand in (os.path.join(CONFIG_DIR, arg),
                 os.path.join(CONFIG_DIR, arg + ".yml")):
        if os.path.isfile(cand):
            return cand
    avail = sorted(f for f in os.listdir(CONFIG_DIR) if f.endswith(".yml"))
    raise SystemExit(f"unknown config '{arg}'. Available: {', '.join(avail)}")


def validate_config(path):
    if not os.path.isfile(path):
        raise SystemExit(f"config not found: {path}")
    p = subprocess.run(["camilladsp", "--check", path],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if p.returncode != 0:
        raise SystemExit(f"config check failed for {path}:\n{p.stdout}")
    print(f"config check OK: {path}")


def update_statefile(path):
    """Point the statefile at the new config (survives restarts/reboots)."""
    with open(STATEFILE, encoding="utf-8") as f:
        lines = f.readlines()
    found = False
    for i, line in enumerate(lines):
        if line.startswith("config_path:"):
            lines[i] = f"config_path: {path}\n"
            found = True
            break
    if not found:
        raise SystemExit(f"no config_path line in {STATEFILE}, refusing to guess")
    with open(STATEFILE, "w", encoding="utf-8") as f:
        f.writelines(lines)
    print(f"statefile updated: {STATEFILE}")


def do_status():
    try:
        ok, path = check_result("GetConfigFilePath", ws_query("GetConfigFilePath"))
        ok2, state = check_result("GetState", ws_query("GetState"))
    except (WsError, OSError, json.JSONDecodeError) as e:
        raise SystemExit(f"websocket query failed ({e}); is camilladsp running?")
    if not ok:
        raise SystemExit(f"GetConfigFilePath failed: {path}")
    print(f"active config: {path}")
    print(f"state: {state if ok2 else '?'}")
    print(f"profiles: with-sub -> {PROFILES['with-sub']}, "
          f"mains-only -> {PROFILES['mains-only']}")


def wait_for_state(want_running=True, tries=16, delay=0.5):
    last = "?"
    for _ in range(tries):
        try:
            ok, last = check_result("GetState", ws_query("GetState"))
            if ok and (last == "Running" or not want_running):
                return last
            if ok and last not in ("Starting", "Inactive"):
                return last
        except (WsError, OSError, json.JSONDecodeError):
            pass
        time.sleep(delay)
    return last


def do_switch(arg):
    target = resolve_target(arg)
    validate_config(target)
    update_statefile(target)
    try:
        ok, err = check_result("SetConfigFilePath",
                               ws_query({"SetConfigFilePath": target}))
        if not ok:
            raise WsError(f"SetConfigFilePath rejected: {err}")
        ok, err = check_result("Reload", ws_query("Reload"))
        if not ok:
            raise WsError(f"Reload rejected: {err}")
    except (WsError, OSError, json.JSONDecodeError) as e:
        print(f"websocket switch failed ({e}), falling back to service restart...")
        p = subprocess.run(["sudo", "-n", "systemctl", "restart", "camilladsp"])
        if p.returncode != 0:
            raise SystemExit("restart failed; switch manually with the GUI at :5005")
        time.sleep(2)
    state = wait_for_state()
    try:
        ok, path = check_result("GetConfigFilePath", ws_query("GetConfigFilePath"))
    except (WsError, OSError, json.JSONDecodeError):
        ok, path = False, "?"
    print(f"active config: {path if ok else '?'}")
    print(f"state: {state}")
    if state == "Stalled":
        print("note: Stalled just means no audio is arriving on USB capture right now.")
    if not ok or os.path.basename(path) != os.path.basename(target):
        raise SystemExit("WARNING: active config does not match target, check the GUI")


def main(argv):
    if len(argv) != 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if len(argv) == 2 else 1
    if argv[1] == "status":
        do_status()
    else:
        do_switch(argv[1])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
